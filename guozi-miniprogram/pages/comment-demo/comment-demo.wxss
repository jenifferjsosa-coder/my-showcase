.demo {
  padding: 28rpx 32rpx 400rpx;
}

.demo-head {
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #f0e6dd;
  margin-bottom: 8rpx;
}

.demo-k {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #b3261e;
}

.demo-t {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a1a16;
  margin-top: 6rpx;
}

.demo-s {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9a8b83;
}

.demo-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.demo-input {
  flex: 1 1 auto;
  height: 64rpx;
  padding: 0 18rpx;
  font-size: 25rpx;
  background: #fbf6ee;
  border-radius: 12rpx;
  margin-right: 14rpx;
}

.demo-btn {
  margin: 0;
  font-size: 24rpx;
  color: #fff;
  background: #b3261e;
  border-radius: 28rpx;
}

.demo-label {
  font-size: 24rpx;
  color: #43302a;
  margin-right: 12rpx;
}

.demo-hint {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: #b5a79f;
}
