page { background: #fbf6ee; }
.head { padding: 36rpx 32rpx 20rpx; }
.h1 { font-size: 54rpx; margin-top: 6rpx; }
.hsub { font-size: 24rpx; color: #514741; line-height: 1.75; margin-top: 12rpx; }

.tl { padding-left: 8rpx; }
.tl-row { display: flex; }
.tl-dot { width: 40rpx; flex: 0 0 auto; display: flex; justify-content: center; position: relative; }
.tl-dot::after { content: ''; position: absolute; top: 28rpx; bottom: 0; width: 2rpx; background: rgba(192, 48, 74, .22); }
.tl-row:last-child .tl-dot::after { display: none; }
.tl-pin { width: 16rpx; height: 16rpx; border-radius: 50%; background: #c0304a; margin-top: 12rpx; }
.tl-b { flex: 1; padding: 0 0 34rpx 12rpx; }
.tl-y { font-size: 21rpx; color: #c0304a; letter-spacing: 1rpx; }
.tl-t { font-size: 32rpx; margin: 2rpx 0 6rpx; }
.tl-d { font-size: 23rpx; color: #514741; line-height: 1.7; }

.hs { display: flex; flex-wrap: wrap; }
.hcard { width: 327rpx; margin: 0 12rpx 20rpx; border-radius: 22rpx; overflow: hidden; background: #fffdf8; box-shadow: 0 4rpx 20rpx rgba(84, 44, 28, .07); }
.h-img { width: 100%; height: 240rpx; }
.h-b { padding: 16rpx 18rpx 20rpx; }
.h-n { font-size: 27rpx; }
.h-s { font-size: 20rpx; color: #c0304a; margin-top: 4rpx; }

.list { padding: 0 24rpx; }
.row { display: flex; margin: 0 12rpx 22rpx; padding: 18rpx; }
.row-img { width: 180rpx; height: 180rpx; border-radius: 18rpx; flex: 0 0 auto; }
.row-b { flex: 1; padding-left: 20rpx; display: flex; flex-direction: column; justify-content: center; }
.row-n { font-size: 30rpx; }
.row-a { font-size: 21rpx; color: #c0304a; margin: 4rpx 0 8rpx; }
.row-l { font-size: 22rpx; color: #514741; line-height: 1.6; }

.dial { display: flex; flex-wrap: wrap; }
.dcell { width: 327rpx; margin: 0 12rpx 16rpx; padding: 22rpx 24rpx; background: #fffdf8; border-radius: 20rpx; }
.dk { font-size: 34rpx; color: #c0304a; }
.dv { font-size: 21rpx; color: #514741; margin-top: 6rpx; line-height: 1.6; }

.night { position: relative; height: 320rpx; border-radius: 24rpx; overflow: hidden; margin-top: 10rpx; }
.night-img { width: 100%; height: 100%; }
.night-mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: linear-gradient(180deg, rgba(10, 6, 4, 0) 20%, rgba(10, 6, 4, .82) 100%); }
.night-cap { position: absolute; left: 26rpx; right: 26rpx; bottom: 24rpx; }
.nc-t { font-size: 34rpx; color: #fff; }
.nc-s { font-size: 21rpx; color: rgba(255, 255, 255, .82); margin-top: 6rpx; }
/* 山与海 */
.geo { background: #fffdf8; border-radius: 26rpx; padding: 28rpx 26rpx; box-shadow: 0 6rpx 22rpx rgba(29, 25, 23, .06); }
.geo-row { display: flex; align-items: flex-start; padding: 18rpx 0; border-bottom: 1px solid #f0e8dd; }
.geo-row:last-of-type { border-bottom: none; }
.geo-n { width: 150rpx; flex: 0 0 auto; display: flex; align-items: baseline; }
.geo-v { font-size: 40rpx; color: #b3261e; font-family: "Songti SC", serif; }
.geo-u { font-size: 20rpx; color: #8b8078; margin-left: 6rpx; }
.geo-b { flex: 1; }
.geo-t { font-size: 27rpx; color: #1d1917; margin-bottom: 6rpx; }
.geo-d { font-size: 23rpx; color: #5b524c; line-height: 1.7; }
.geo-sum { margin-top: 18rpx; font-size: 24rpx; color: #3f3630; line-height: 1.8; background: #fbf2e6; border-radius: 16rpx; padding: 18rpx 20rpx; }
.geo-src { margin-top: 12rpx; font-size: 19rpx; color: #a29890; }
