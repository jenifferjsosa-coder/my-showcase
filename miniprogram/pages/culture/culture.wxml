<view class="page">
  <view class="head">
    <text class="kicker">CULTURE</text>
    <view class="h1 serif">好心之城</view>
    <view class="hsub">“我事三代主，唯用一好心。”冼夫人留下的一句话，成了茂名的城市精神；年例、木偶戏、跳花棚、飘色，把它演成了活着的日常。</view>
  </view>

  <!-- 时间轴 -->
  <view class="sec">
    <text class="kicker">TIME</text>
    <view class="sec-title">时间轴</view>
  </view>
  <view class="pad">
    <view class="tl">
      <view class="tl-row" wx:for="{{timeline}}" wx:key="y">
        <view class="tl-dot"><view class="tl-pin"></view></view>
        <view class="tl-b">
          <text class="tl-y">{{item.y}}</text>
          <view class="tl-t serif">{{item.t}}</view>
          <view class="tl-d">{{item.d}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 非遗 -->
  <view class="sec">
    <text class="kicker">HERITAGE</text>
    <view class="sec-title">非遗的脸</view>
    <view class="sec-sub">六张照片，六种活着的传统。</view>
  </view>
  <view class="pad">
    <view class="hs">
      <view class="hcard" wx:for="{{heritage}}" wx:key="id">
        <image class="h-img" src="{{item.img}}" mode="aspectFill"></image>
        <view class="h-b">
          <view class="h-n">{{item.n}}</view>
          <view class="h-s">{{item.s}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 故事 -->
  <view class="sec">
    <text class="kicker">STORY</text>
    <view class="sec-title">六个人的茂名</view>
  </view>
  <view class="list">
    <view class="row card" wx:for="{{stories}}" wx:key="id" bindtap="openItem" data-id="{{item.id}}">
      <image class="row-img" src="{{item.img}}" mode="aspectFill"></image>
      <view class="row-b">
        <view class="row-n">{{item.name}}</view>
        <view class="row-a">{{item.area}} · {{item.tag}}</view>
        <view class="row-l">{{item.line}}</view>
      </view>
    </view>
  </view>

  <!-- 方言 -->
  <view class="sec">
    <text class="kicker">DIALECT</text>
    <view class="sec-title">几句茂名话</view>
    <view class="sec-sub">听懂这几句，菜市场就不会吃亏。</view>
  </view>
  <view class="pad">
    <view class="dial">
      <view class="dcell" wx:for="{{dialect}}" wx:key="k">
        <view class="dk serif">{{item.k}}</view>
        <view class="dv">{{item.v}}</view>
      </view>
    </view>
  </view>

  <!-- 夜色 -->
  <view class="pad">
    <view class="night">
      <image class="night-img" src="{{night}}" mode="aspectFill"></image>
      <view class="night-mask"></view>
      <view class="night-cap">
        <view class="nc-t serif">夜里的油城</view>
        <view class="nc-s">灯一盏盏亮起来，茂名才慢慢安静下来。</view>
      </view>
    </view>
  </view>

  <view class="note">年例时间各村不同，多在农历正月到二月；看年例请跟着本地人走，别挡队伍。</view>
</view>
