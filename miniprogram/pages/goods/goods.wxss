page { background: #fbf6ee; }
.head { padding: 36rpx 32rpx 24rpx; }
.h1 { font-size: 56rpx; letter-spacing: 2rpx; margin-top: 6rpx; }
.hsub { font-size: 24rpx; color: #514741; line-height: 1.75; margin-top: 12rpx; }

.grid { display: flex; flex-wrap: wrap; padding: 26rpx 24rpx 0; }
.gcard { width: 327rpx; margin: 0 12rpx 24rpx; }
.g-img { width: 100%; height: 400rpx; }
.g-b { padding: 18rpx 20rpx 22rpx; }
.g-n { font-size: 32rpx; }
.g-a { font-size: 21rpx; color: #8b8078; margin: 4rpx 0 10rpx; }

.tiles { display: flex; flex-wrap: wrap; }
.tile {
  width: 327rpx; margin: 0 12rpx 20rpx; padding: 24rpx; border-radius: 22rpx;
  background: #fffdf8; box-shadow: 0 4rpx 20rpx rgba(84, 44, 28, .07);
}
.tile-n { font-size: 32rpx; }
.tile-c { font-size: 21rpx; color: #c0304a; margin-top: 4rpx; }
