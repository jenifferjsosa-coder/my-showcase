page { background: #fbf6ee; }
.cover { height: 480rpx; }
.cover-img { width: 100%; height: 100%; }
.body { padding: 28rpx 32rpx 240rpx; }
.t { font-size: 56rpx; letter-spacing: 2rpx; margin: 6rpx 0 8rpx; }
.line { font-size: 25rpx; color: #514741; line-height: 1.7; }
.pills { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.pill { font-size: 21rpx; color: #514741; background: #f1e9e0; padding: 8rpx 18rpx; border-radius: 999rpx; margin: 0 12rpx 12rpx 0; }
.pill.red { background: rgba(192, 48, 74, .12); color: #c0304a; }

.block { margin-top: 34rpx; }
.b-h { font-size: 26rpx; color: #1d1917; display: flex; align-items: center; margin-bottom: 16rpx; }
.bar { width: 6rpx; height: 26rpx; background: #c0304a; border-radius: 4rpx; margin-right: 12rpx; }
.cnt { font-size: 19rpx; color: #fff; background: #c0304a; border-radius: 999rpx; padding: 2rpx 12rpx; margin-left: 10rpx; }

.stats2 { display: flex; flex-wrap: wrap; }
.s2 { width: 320rpx; margin: 0 10rpx 14rpx 0; padding: 22rpx; background: #fffdf8; border-radius: 20rpx; box-shadow: 0 4rpx 18rpx rgba(84, 44, 28, .06); }
.s2-v { display: flex; align-items: baseline; }
.s2-n { font-family: Georgia, serif; font-size: 44rpx; color: #1d1917; }
.s2-u { font-size: 20rpx; color: #8b8078; margin-left: 6rpx; }
.s2-l { font-size: 20rpx; color: #8b8078; margin-top: 4rpx; }

.mrow { display: flex; flex-wrap: wrap; }
.mcell { width: 74rpx; height: 74rpx; margin: 0 10rpx 10rpx 0; border-radius: 14rpx; background: #f1e9e0; color: #8b8078; font-size: 21rpx; display: flex; align-items: center; justify-content: center; }
.mcell.on { background: #c0304a; color: #fff; }

.kl { margin-top: 4rpx; }
.k { display: flex; padding: 18rpx 0; border-bottom: 1rpx dashed rgba(29, 25, 23, .12); }
.k:last-child { border-bottom: 0; }
.kid { width: 44rpx; height: 44rpx; border-radius: 50%; background: #f3e7e2; color: #c0304a; font-size: 21rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; margin-top: 4rpx; }
.kb { flex: 1; padding-left: 16rpx; }
.kn { display: flex; align-items: center; flex-wrap: wrap; }
.kname { font-size: 29rpx; }
.kt { font-size: 19rpx; color: #0f6771; background: rgba(15, 103, 113, .1); padding: 3rpx 10rpx; border-radius: 8rpx; margin-left: 10rpx; }
.kd { font-size: 22rpx; color: #514741; line-height: 1.65; margin-top: 4rpx; }

.para { font-size: 25rpx; color: #3a322d; line-height: 1.85; margin-bottom: 18rpx; }

.tip { margin-top: 26rpx; padding: 24rpx; background: rgba(15, 103, 113, .07); border-radius: 20rpx; }
.tip-k { font-size: 21rpx; color: #0f6771; margin-right: 10rpx; }
.tip-v { font-size: 23rpx; color: #2b464a; line-height: 1.7; }

.bar-bottom { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255, 253, 248, .96); box-shadow: 0 -6rpx 24rpx rgba(84, 44, 28, .08); }
.bb-fav { flex: 0 0 auto; padding: 20rpx 34rpx; border-radius: 999rpx; font-size: 25rpx; color: #c0304a; background: rgba(192, 48, 74, .1); }
.bb-fav.on { background: #c0304a; color: #fff; }
.bb-share { flex: 1; margin-left: 18rpx; height: 84rpx; line-height: 84rpx; border-radius: 999rpx; background: #c0304a; color: #fff; font-size: 27rpx; padding: 0; }
.bb-share::after { border: 0; }
